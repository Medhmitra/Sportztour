# --- Django core ---
DEBUG=False
SECRET_KEY=change_this_to_a_random_50_char_string
ALLOWED_HOSTS=127.0.0.1,localhost,your-ec2-public-ip,yourdomain.com

# --- Database (use a strong password, not "postgres") ---
# CRITICAL: POSTGRES_PASSWORD and the password inside DATABASE_URL must match exactly!
POSTGRES_DB=sportztour
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password
DATABASE_URL=postgres://postgres:postgres_strong_password@db:5432/sportztour

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (your frontend's actual URL) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://your-ec2-public-ip:3000,https://yourdomain.com

# --- HTTPS (only set True once SSL/domain is configured) ---
SECURE_SSL_REDIRECT=False
